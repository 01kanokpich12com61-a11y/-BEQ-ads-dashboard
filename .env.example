# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า (บน Render ให้ใส่ใน Environment แทน ไม่ต้องมีไฟล์ .env)
# ⚠️ ห้าม commit ไฟล์ .env หรือโฟลเดอร์ data/ ขึ้น GitHub

PORT=3000
# 127.0.0.1 = เปิดเฉพาะเครื่องตัวเอง / 0.0.0.0 = เปิดให้เครื่องอื่นเข้าได้ (บน Render ตั้งให้อัตโนมัติ)
HOST=127.0.0.1

# production = เปิดโหมดปลอดภัย (Render ถือเป็น production อัตโนมัติ)
NODE_ENV=

# ---------- บัญชีผู้ดูแล (สร้างอัตโนมัติครั้งแรกที่รัน ถ้ายังไม่มีผู้ใช้) ----------
ADMIN_USER=admin
# ควรตั้งเสมอบน production; ถ้าไม่ตั้ง production จะสุ่มรหัสชั่วคราวและพิมพ์ไว้ใน log
ADMIN_PASSWORD=
# ลืมรหัส admin: ใส่รหัสใหม่ (≥ 8 ตัว) แล้วรีสตาร์ท จากนั้นลบค่านี้ออก
ADMIN_RESET_PASSWORD=

# ---------- ความปลอดภัย ----------
# เปิด Secure cookie (ค่าเริ่มต้น: เปิดอัตโนมัติบน production)
COOKIE_SECURE=
# อ่าน IP จริงจาก X-Forwarded-For เมื่ออยู่หลัง reverse proxy (ค่าเริ่มต้น: เปิดอัตโนมัติบน Render)
TRUST_PROXY=

# ---------- ฐานข้อมูลถาวร (จำเป็นบน Render ไม่งั้นข้อมูลหายทุกครั้งที่ deploy) ----------
SUPABASE_URL=
# ใช้ service_role key (เก็บฝั่งเซิร์ฟเวอร์เท่านั้น) และเปิด RLS ที่ตาราง kv
SUPABASE_KEY=

# ---------- Meta (Facebook / Instagram / WhatsApp) ----------
META_API_VERSION=v25.0
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
# ค่าที่ใส่ใน Meta Developers > Webhooks > Verify Token (สุ่มยาว ๆ เช่น openssl rand -hex 16)
WEBHOOK_VERIFY_TOKEN=

# ---------- LINE Official Account ----------
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# ---------- น้อง AI (ผู้ช่วยตอบคำถามจากข้อมูลในเว็บ) ----------
# สร้าง key ที่ console.anthropic.com (คิดค่าใช้จ่ายตามการใช้งาน) ไม่ตั้ง = ใช้โหมดพื้นฐาน
ANTHROPIC_API_KEY=
# รุ่นโมเดล (ค่าเริ่มต้น claude-sonnet-5-5)
ASSISTANT_MODEL=
